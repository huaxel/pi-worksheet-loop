{
  "name": "@juanbenjumea/pi-worksheet-loop",
  "version": "0.1.1",
  "description": "Markdown-first collaborative worksheets for Pi",
  "type": "module",
  "license": "MIT",
  "author": "Juan Benjumea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huaxel/pi-worksheet-loop.git"
  },
  "engines": {
    "node": ">=22.7"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "markdown",
    "worksheet",
    "collaboration"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "test": "node --test worksheet-loop.test.mjs worksheet-loop.runtime.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "files": [
    "index.ts",
    "SKILL.md",
    "README.md",
    "DESIGN.md",
    "ROADMAP.md",
    "DECISIONS.md",
    "FAILURE-MODES.md",
    "SECTION-AWARE-FORMAT.md",
    "RESEARCH.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
